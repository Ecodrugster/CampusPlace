# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (leave EMAIL_HOST empty to log codes to console)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CampusPlace <noreply@campusplace.local>
EMAIL_VERIFICATION_DEV_FALLBACK=True

# Database: keep USE_POSTGRES=False for local SQLite
USE_POSTGRES=False
POSTGRES_DB=campusplace
POSTGRES_USER=campusplace
POSTGRES_PASSWORD=campusplace
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Channels: keep USE_REDIS=False for InMemory (dev)
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0
